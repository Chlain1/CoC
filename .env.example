# Clash of Clans API Token
# Hol deinen Token von https://developer.clashofclans.com/
COC_API_TOKEN=dein_api_token_hier

# Optional: Dein Player-Tag für automatische Clan-Erkennung (OHNE #)
# Wenn gesetzt, wird dein Clan automatisch verwendet wenn kein --clan angegeben wird
# Beispiel: COC_PLAYER_TAG=ABC123XYZ (das # wird automatisch hinzugefügt)
COC_PLAYER_TAG=DEIN_PLAYER_TAG
